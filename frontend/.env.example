# ---------------------------------------------------------------------------
# Frontend config. Copy to .env.local (gitignored).
# The browser NEVER holds an LLM API key -- it only calls this project's own
# FastAPI backend, which holds the key server-side.
# ---------------------------------------------------------------------------

# Where the Python backend is running.
VITE_API_URL=http://localhost:8000

# true  = offline sample answers, no backend needed (default)
# false = call the real backend at VITE_API_URL
VITE_USE_MOCK=true
