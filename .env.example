# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored -- NEVER commit real values.
# On a deploy host (Render/Railway/Fly/etc) set these in the dashboard's
# environment settings instead of shipping a file.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# gemini = deployment, ollama = local development
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Current Flash-tier text model (verified at ai.google.dev/gemini-api/docs/models).
# Run `python llm_provider.py --list-models` to confirm against the live endpoint.
GEMINI_MODEL=gemini-3.8-flash

# If the primary provider fails (e.g. free-tier 429 after backoff), answer with the
# other provider instead. This uses a DIFFERENT MODEL, so it is reported in the
# response as providerFallback. Set false to fail loudly instead.
LLM_FALLBACK=true

# Local development provider (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# --- databases (SQLAlchemy URLs) -------------------------------------------
# Local development:
DB_MOVIELENS=postgresql+psycopg2://postgres:pass@localhost:5432/movielens
DB_OLIST=postgresql+psycopg2://postgres:pass@localhost:5432/olist
DB_SOCCER=sqlite:///data/soccer/database.sqlite
# Deployment: use the managed database URL, e.g.
# DB_OLIST=postgresql+psycopg2://user:password@host:5432/olist?sslmode=require

# --- agent behaviour --------------------------------------------------------
USE_SAMPLES=true        # Phase 4a: sample values in the schema
USE_MEMORY=true         # Phase 4b: retrieved worked examples (drives accuracy)
K_EXAMPLES=3            # k=1 costs ~23 accuracy points (Phase 6 ablation)
MAX_RETRIES=3           # Phase 3 self-correction
MAX_ROWS=200            # DISPLAY cap only; never injected into the SQL
SQL_TIMEOUT_S=30

# --- frontend -------------------------------------------------------------
ALLOWED_ORIGINS=*
